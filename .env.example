HELIUS_API_KEY=
# Optional stable image-proxy signing secret; otherwise uses SESSION_SECRET or HELIUS_API_KEY.
TOKEN_IMAGE_SIGNING_SECRET=
SUPABASE_URL=
# Server only: Supabase Secret API key (sb_secret_...). Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SESSION_SECRET=
GENERATION_WORKER_SECRET=
GENERATION_WORKER_URL=http://localhost:5173/api/generation/worker
# Existing-attempt verification only; uses GENERATION_WORKER_SECRET. No broadcasts.
LAUNCH_RECONCILER_URL=http://localhost:5173/api/launch/reconcile
# Only a client-IP header overwritten by your trusted hosting proxy; blank shares one IP bucket.
TRUSTED_CLIENT_IP_HEADER=
MAX_CUSTOM_GENERATIONS_PER_HOUR=3000
MAX_CUSTOM_GENERATIONS_PER_DAY=9000
MAX_CUSTOM_GENERATIONS_PER_USER_HOUR=3
MAX_AI_WORKER_CONCURRENCY=25

# Phase 2B — server only. Blank values use documented defaults.
OPENAI_API_KEY=
AI_PROVIDER=
AI_TEXT_MODEL=
AI_IMAGE_MODEL=
AI_IMAGE_QUALITY=
AI_PARENT_REFERENCE_MAX_EDGE=
AI_PARENT_REFERENCE_MAX_BYTES=
AI_PROMPT_VERSION_PARENT=
# Defaults: offspring-concept-v3 and offspring-image-v2.
AI_PROMPT_VERSION_CONCEPT=
AI_PROMPT_VERSION_IMAGE=
# Enable only for the explicit developer smoke script; public generation stays false.
AI_SMOKE_TESTS_ENABLED=
AI_SMOKE_APP_URL=

# Phase 3 — server-only. Mainnet launches require both explicit enable switches.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=
PINATA_JWT=
PUMP_LAUNCH_ENABLED=false
PUMP_MAINNET_LAUNCH_ENABLED=false
TOKEN_WEBSITE_URL=
TOKEN_TWITTER_URL=
# Optional existing active lookup table for atomic Pump create_v2 + buy_v2 (server only).
# Required for initial buy if the legacy transaction exceeds Solana's size limit.
PUMP_ADDRESS_LOOKUP_TABLE=
# Optional UUID for /wallet-check on localhost only, with both launch switches false.
PUMP_WALLET_CHECK_OFFSPRING_ID=
